# Copy to .env. Names only here; .env is ignored. Every EDP_* variable is documented in
# specs/001-evidence-experiment-design/contracts/stages.md.
EDP_API_TOKEN=change-me
EDP_REVIEWERS_FILE=reviewers.json
EDP_TIER=replay
# EDP_RECORD=1
EDP_CASSETTES=evals/cassettes
EDP_MODEL=claude-opus-5-5
EDP_EMBEDDING_MODEL=hash
EDP_EMBEDDING_CACHE=~/.cache/edp
EDP_RETRY_BUDGET=2
EDP_SUPPLEMENTAL_BUDGET=2
EDP_DECISIONS=recommend production feasibility;propose a feasibility experiment on lipid accumulation
EDP_INTERNAL_DIR=internal
# EDP_CONTACT_EMAIL=   # sent to Europe PMC, Crossref and NCBI as the polite contact
# EDP_NCBI_API_KEY=    # optional; ten PubMed requests a second instead of three
# ANTHROPIC_API_KEY=   # the live tier only; read by the model provider, never by this service's code
