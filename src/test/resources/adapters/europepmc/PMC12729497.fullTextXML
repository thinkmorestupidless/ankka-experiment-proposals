</person-group><article-title>Adipogenic Genes Expression in Relation to Hepatic Steatosis in the Liver of Two Duck Species</article-title><source>Animal</source><year>2018</year><volume>12</volume><fpage>2571</fpage><lpage>2577</lpage><pub-id pub-id-type="doi">10.1017/S1751731118000897</pub-id><pub-id pub-id-type="pmid">29720294</pub-id></element-citation></ref><ref id="B10-animals-15-03603"><label>10.</label><element-citation publication-type="journal"><person-group person-group-type="author">
<name name-style="western"><surname>Miao</surname><given-names>S.</given-names></name>
<name name-style="western"><surname>Xu</surname><given-names>M.</given-names></name>
<name name-style="western"><surname>Liu</surname><given-names>F.</given-names></name>
<name name-style="western"><surname>Dong</surname><given-names>X.</given-names></name>
<name name-style="western"><surname>Zou</surname><given-names>X.</given-names></name>
