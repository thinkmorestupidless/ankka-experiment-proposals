{
  "name": "experiment-proposals-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server/server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node server/server.ts",
    "typecheck": "tsc",
    "test": "node --test 'test/**/*.test.ts'",
    "features": "bddgen && playwright test --project features",
    "check": "playwright test --project walkthrough --project cards --project accessibility"
  },
  "dependencies": {
    "lucide-react": "^1.62.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@react-router/dev": "^8.5.0",
    "@react-router/node": "^8.4.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-bdd": "^9.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
